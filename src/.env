APP_NAME="Mini RAG App"
APP_VERSION="0.1.0"
APP_DESCRIPTION="A simple Retrieval-Augmented Generation (RAG) application built with FastAPI."
OPENAI_API_KEY="your_openai_api_key_here"
FILE_ALLOWED_EXTENSIONS=["text/plain", "application/pdf"]
FILE_MAX_SIZE_MB=10
FILE_DEFAULT_CHUNK_SIZE=512000
# Define the raw credentials once
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=admin
MONGO_DB_NAME="mini_rag_db"

MONGO_URL="mongodb://${MONGO_INITDB_ROOT_USERNAME}:${MONGO_INITDB_ROOT_PASSWORD}@localhost:27007/?authSource=admin"
# Build the URL using the variables above
# MONGO_URL="mongodb://localhost:27007"

# python-dotenv="1.0.1"